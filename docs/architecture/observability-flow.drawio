        <mxCell id="__t" value="Where a metric, a log and a span actually go" style="text;html=1;fontFamily=Helvetica;fontSize=22;fontStyle=1;fontColor=#1E293B;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="1100" height="30" as="geometry" />
        </mxCell>
        <mxCell id="__ts" value="Three stores, one Grafana, one alerting path. Everything here runs in single-node mode: the cluster-mode HelmReleases exist in the same directories but are commented out of their kustomization.yaml." style="text;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#64748B;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="62" width="1300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="&lt;b&gt;Pods and Services&lt;/b&gt;&#xa;VMServiceScrape · VMPodMonitor" style="rounded=1;absoluteArcSize=1;arcSize=10;shadow=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;strokeWidth=1.5;fontColor=#1E293B;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="280" height="66" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;kube-state-metrics, node-exporter&lt;/b&gt;&#xa;bundled with victoria-metrics-k8s-stack" style="rounded=1;absoluteArcSize=1;arcSize=10;shadow=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;strokeWidth=1.5;fontColor=#1E293B;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
