        <mxCell id="runlore" value="&lt;b&gt;RunLore&lt;/b&gt;&#xa;webhook http://runlore.runlore.svc:8080&#xa;/webhook/alertmanager — bearer token from&#xa;an ExternalSecret; the agent investigates" style="rounded=1;absoluteArcSize=1;arcSize=10;shadow=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;strokeWidth=1.5;fontColor=#1E293B;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
