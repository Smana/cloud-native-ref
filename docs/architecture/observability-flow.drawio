        <mxCell id="ms" value="metrics-server also runs here, but it is not part of this path: it serves the resource metrics API for HPAs and stores nothing." style="text;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#64748B;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
