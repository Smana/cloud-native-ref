        <mxCell id="vmrule" value="&lt;b&gt;VMRule&lt;/b&gt;&#xa;PromQL rules against VMSingle and&#xa;LogsQL rules with type: vlogs against&#xa;VictoriaLogs — one mechanism, both stores" style="rounded=1;absoluteArcSize=1;arcSize=10;shadow=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;strokeWidth=1.5;fontColor=#1E293B;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
