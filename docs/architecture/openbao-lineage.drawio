<mxfile host="drawio" version="30.3.6">
  <diagram name="The lineage" id="openbao-lineage">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" page="1" pageWidth="1640" pageHeight="960" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t1" value="OpenBao: the node is disposable, the lineage is not" style="text;html=1;fontFamily=Helvetica;fontSize=22;fontStyle=1;fontColor=#1E293B;align=left;" vertex="1" parent="1">
          <mxGeometry x="50" y="24" width="1000" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="Destroyed nightly and rebuilt from its newest snapshot. What survives is the &lt;i&gt;lineage&lt;/i&gt;: a seal key, five bootstrap secrets, a bucket of snapshots." style="text;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#64748B;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="50" y="56" width="1250" height="34" as="geometry" />
        </mxCell>

        <mxCell id="zA" value="Persists across every teardown" style="rounded=0;html=1;fillColor=#FAF5FF;strokeColor=#7C3AED;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#6D28D9;" vertex="1" parent="1">
          <mxGeometry x="50" y="110" width="420" height="500" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="&lt;b&gt;Multi-region KMS seal key&lt;/b&gt;&#xa;alias/openbao-seal · eu-west-3 primary&#xa;replica in eu-west-1" style="rounded=0;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=1.5;whiteSpace=wrap;align=left;spacingLeft=10;fontFamily=Helvetica;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="70" y="148" width="380" height="62" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="&lt;b&gt;Five bootstrap secrets&lt;/b&gt;, per cloud&#xa;ca-chain · server cert + key · root token&#xa;recovery keys · offline-signed intermediate" style="rounded=0;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=1.5;whiteSpace=wrap;align=left;spacingLeft=10;fontFamily=Helvetica;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="70" y="250" width="380" height="62" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="&lt;b&gt;Snapshot bucket&lt;/b&gt; — S3, versioned&#xa;&lt;i&gt;&amp;lt;UTC timestamp&amp;gt;-&amp;lt;seal&amp;gt;.snap&lt;/i&gt; · 120-day expiry" style="rounded=0;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=1.5;whiteSpace=wrap;align=left;spacingLeft=10;fontFamily=Helvetica;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="70" y="340" width="380" height="52" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="&lt;b&gt;GCS mirror&lt;/b&gt; — Storage Transfer, daily&#xa;federated identity, no key at rest either side" style="rounded=0;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=1.5;whiteSpace=wrap;align=left;spacingLeft=10;fontFamily=Helvetica;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="70" y="432" width="250" height="52" as="geometry" />
        </mxCell>

        <mxCell id="zB" value="Rebuilt on every deploy — derived state" style="rounded=0;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="600" y="110" width="440" height="500" as="geometry" />
        </mxCell>
        <mxCell id="b0" value="&lt;b&gt;The OpenBao node&lt;/b&gt; — EC2, single node&#xa;auto-unsealed by the seal key, no operator input" style="shape=label;rounded=0;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;strokeWidth=1.5;whiteSpace=wrap;align=left;spacingLeft=10;fontFamily=Helvetica;fontSize=11;fontColor=#1E293B;image=data:image/png,;imageAlign=left;imageVerticalAlign=middle;imageWidth=24;imageHeight=24;spacingLeft=42;" vertex="1" parent="1">
          <mxGeometry x="620" y="148" width="400" height="52" as="geometry" />
        </mxCell>
        <mxCell id="b1" value="&lt;b&gt;Raft store&lt;/b&gt;&#xa;in every mode" style="rounded=0;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;strokeWidth=1.5;whiteSpace=wrap;align=left;spacingLeft=10;fontFamily=Helvetica;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="620" y="224" width="190" height="48" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="&lt;b&gt;pki_private_issuer&lt;/b&gt;&#xa;the offline-signed intermediate, imported" style="rounded=0;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;strokeWidth=1.5;whiteSpace=wrap;align=left;spacingLeft=10;fontFamily=Helvetica;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="620" y="284" width="400" height="48" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="&lt;b&gt;lineage/&lt;/b&gt; kv-v2 — check_timestamp" style="rounded=0;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;strokeWidth=1.5;whiteSpace=wrap;align=left;spacingLeft=10;fontFamily=Helvetica;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="620" y="344" width="190" height="40" as="geometry" />
        </mxCell>
        <mxCell id="b4" value="&lt;b&gt;jwt/&amp;lt;cluster&amp;gt;&lt;/b&gt; — one mount each" style="rounded=0;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;strokeWidth=1.5;whiteSpace=wrap;align=left;spacingLeft=10;fontFamily=Helvetica;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="830" y="344" width="190" height="40" as="geometry" />
        </mxCell>
        <mxCell id="bn" value="&lt;b&gt;No AppRole anywhere.&lt;/b&gt; There is no generated machine credential to store, rotate or leak — every consumer presents a projected ServiceAccount token instead." style="rounded=0;html=1;fillColor=#D1FAE5;strokeColor=#059669;strokeWidth=1.5;whiteSpace=wrap;align=left;spacingLeft=10;spacingTop=4;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#065F46;" vertex="1" parent="1">
          <mxGeometry x="620" y="400" width="400" height="52" as="geometry" />
        </mxCell>

        <mxCell id="zC" value="Consumers — JWT only" style="rounded=0;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="1160" y="110" width="430" height="500" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="&lt;b&gt;cert-manager&lt;/b&gt; · ns security&#xa;role cert-manager — issues every internal TLS leaf" style="shape=label;rounded=0;html=1;fillColor=#E0E7FF;strokeColor=#6366F1;strokeWidth=1.5;whiteSpace=wrap;align=left;spacingLeft=10;fontFamily=Helvetica;fontSize=11;fontColor=#1E293B;image=data:image/png,;imageAlign=left;imageVerticalAlign=middle;imageWidth=24;imageHeight=24;spacingLeft=42;" vertex="1" parent="1">
          <mxGeometry x="1180" y="148" width="390" height="52" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="&lt;b&gt;External Secrets&lt;/b&gt; · ns security&#xa;role external-secrets" style="rounded=0;html=1;fillColor=#E0E7FF;strokeColor=#6366F1;strokeWidth=1.5;whiteSpace=wrap;align=left;spacingLeft=10;fontFamily=Helvetica;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="1180" y="212" width="390" height="52" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;openbao-snapshot&lt;/b&gt; CronJob · 04:00 UTC&#xa;stamps the marker, then writes the object" style="shape=label;rounded=0;html=1;fillColor=#E0E7FF;strokeColor=#6366F1;strokeWidth=1.5;whiteSpace=wrap;align=left;spacingLeft=10;fontFamily=Helvetica;fontSize=11;fontColor=#1E293B;image=data:image/png,;imageAlign=left;imageVerticalAlign=middle;imageWidth=24;imageHeight=24;spacingLeft=42;" vertex="1" parent="1">
          <mxGeometry x="1180" y="276" width="390" height="52" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="All three reach OpenBao at one neutral in-cluster name:&#xa;&lt;b&gt;openbao.security.svc.cluster.local:8200&lt;/b&gt;&#xa;A failover changes what that name points at — never the clients." style="rounded=0;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1.5;whiteSpace=wrap;align=left;spacingLeft=10;spacingTop=4;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="1180" y="344" width="390" height="66" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7C3AED;strokeWidth=2.5;endArrow=classic;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="a3" target="b1">
