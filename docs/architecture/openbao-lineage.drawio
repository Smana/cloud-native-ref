  <diagram name="Fallback and the drill" id="openbao-fallback">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" page="1" pageWidth="1640" pageHeight="960" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="s1" value="Cross-cloud fallback, and the drill that keeps it honest" style="text;html=1;fontFamily=Helvetica;fontSize=22;fontStyle=1;fontColor=#1E293B;align=left;" vertex="1" parent="1">
          <mxGeometry x="50" y="24" width="1000" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="A snapshot restores only under the seal that encrypted it — so the GCP standby uses the AWS key, over federation, holding no AWS credential." style="text;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#64748B;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="50" y="56" width="1250" height="34" as="geometry" />
        </mxCell>

        <mxCell id="pA" value="AWS — the active side" style="rounded=0;html=1;fillColor=#FAF5FF;strokeColor=#7C3AED;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#6D28D9;" vertex="1" parent="1">
          <mxGeometry x="50" y="110" width="450" height="250" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="&lt;b&gt;KMS seal key&lt;/b&gt; — alias/openbao-seal&#xa;multi-region, replica in eu-west-1" style="rounded=0;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=1.5;whiteSpace=wrap;align=left;spacingLeft=10;fontFamily=Helvetica;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="70" y="150" width="410" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="&lt;b&gt;S3 snapshot bucket&lt;/b&gt;&#xa;every object AWS-sealed by construction" style="rounded=0;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=1.5;whiteSpace=wrap;align=left;spacingLeft=10;fontFamily=Helvetica;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="70" y="220" width="410" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="&lt;b&gt;openbao-standby-seal&lt;/b&gt; IAM role&#xa;trusts accounts.google.com, scoped by key alias + condition" style="rounded=0;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=1.5;whiteSpace=wrap;align=left;spacingLeft=10;fontFamily=Helvetica;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="70" y="290" width="410" height="52" as="geometry" />
        </mxCell>

        <mxCell id="pB" value="GCP — the standby" style="rounded=0;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#B45309;" vertex="1" parent="1">
          <mxGeometry x="700" y="110" width="450" height="250" as="geometry" />
        </mxCell>
        <mxCell id="q1" value="&lt;b&gt;GCS mirror bucket&lt;/b&gt;&#xa;the AWS objects, same names, same sizes" style="rounded=0;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=1.5;whiteSpace=wrap;align=left;spacingLeft=10;fontFamily=Helvetica;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="720" y="150" width="410" height="52" as="geometry" />
        </mxCell>
        <mxCell id="q2" value="&lt;b&gt;GCE node&lt;/b&gt; — seal_provider = awskms&#xa;systemd timer writes a GCE identity token to disk" style="rounded=0;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=1.5;whiteSpace=wrap;align=left;spacingLeft=10;fontFamily=Helvetica;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="720" y="220" width="410" height="52" as="geometry" />
        </mxCell>
        <mxCell id="q3" value="&lt;b&gt;AWS_ROLE_ARN + AWS_WEB_IDENTITY_TOKEN_FILE&lt;/b&gt;&#xa;the only two variables — no static credential exists" style="rounded=0;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=1.5;whiteSpace=wrap;align=left;spacingLeft=10;fontFamily=Helvetica;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="720" y="290" width="410" height="52" as="geometry" />
        </mxCell>

        <mxCell id="x1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7C3AED;strokeWidth=2.5;endArrow=classic;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p2" target="q1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="x1l" value="Storage Transfer, daily" style="text;html=1;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#6D28D9;align=center;labelBackgroundColor=#ffffff;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="500" y="228" width="200" height="16" as="geometry" />
        </mxCell>
        <mxCell id="x2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#F59E0B;strokeWidth=2.5;endArrow=classic;endFill=1;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="q3" target="p3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="x2l" value="sts:AssumeRoleWithWebIdentity&#xa;→ decrypt with the AWS key" style="text;html=1;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#B45309;align=center;labelBackgroundColor=#ffffff;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="500" y="298" width="200" height="34" as="geometry" />
        </mxCell>

        <mxCell id="zE" value="Weekly restore drill — GitHub Actions, Mondays 06:00 UTC, two independent jobs" style="shape=label;rounded=0;html=1;fillColor=#F0FDF4;strokeColor=#059669;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#047857;image=data:image/png,;imageAlign=left;imageVerticalAlign=middle;imageWidth=24;imageHeight=24;spacingLeft=42;" vertex="1" parent="1">
          <mxGeometry x="50" y="390" width="1540" height="140" as="geometry" />
        </mxCell>
        <mxCell id="f1" value="&lt;b&gt;restore&lt;/b&gt;&#xa;the newest snapshot into a throwaway node holding nothing but the seal key" style="rounded=0;html=1;fillColor=#D1FAE5;strokeColor=#059669;strokeWidth=1.5;whiteSpace=wrap;align=left;spacingLeft=10;fontFamily=Helvetica;fontSize=11;fontColor=#065F46;" vertex="1" parent="1">
          <mxGeometry x="70" y="436" width="350" height="70" as="geometry" />
        </mxCell>
        <mxCell id="f2" value="&lt;b&gt;verify the chain&lt;/b&gt;&#xa;openssl verify -CAfile against the committed offline root certificate" style="rounded=0;html=1;fillColor=#D1FAE5;strokeColor=#059669;strokeWidth=1.5;whiteSpace=wrap;align=left;spacingLeft=10;fontFamily=Helvetica;fontSize=11;fontColor=#065F46;" vertex="1" parent="1">
