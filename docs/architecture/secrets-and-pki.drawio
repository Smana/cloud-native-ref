<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="30.3.6">
  <diagram name="Secrets and PKI" id="secrets-and-pki">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1520" pageHeight="1030" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="__t" value="Two secret paths, one private CA" style="text;html=1;fontFamily=Helvetica;fontSize=22;fontStyle=1;fontColor=#1E293B;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="1100" height="30" as="geometry" />
        </mxCell>
        <mxCell id="__ts" value="Nothing in this repository holds a credential. Certificates are minted by OpenBao's PKI and delivered by cert-manager; every other secret is pulled from AWS Secrets Manager by External Secrets Operator." style="text;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#64748B;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="62" width="1300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="chain" value="The private CA chain" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#7C3AED;verticalAlign=top;fontStyle=1;fontFamily=Helvetica;fontSize=13;fontColor=#1E293B;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="620" height="630" as="geometry" />
        </mxCell>
        <mxCell id="root" value="&lt;b&gt;Root CA — offline&lt;/b&gt;&#xa;EC secp384r1, generated once with openssl,&#xa;outside OpenTofu and outside OpenBao. Its&#xa;private key is deleted from AWS Secrets&#xa;Manager; only its certificate remains." style="rounded=1;absoluteArcSize=1;arcSize=10;shadow=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=1.5;fontColor=#1E293B;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="160" width="560" height="108" as="geometry" />
        </mxCell>
        <mxCell id="inter" value="&lt;b&gt;Intermediate CA&lt;/b&gt;&#xa;Signed by the offline root with openssl, once,&#xa;then imported cert + key with&#xa;vault_pki_secret_backend_config_ca. It IS the issuer." style="shape=label;rounded=1;absoluteArcSize=1;arcSize=10;shadow=1;whiteSpace=wrap;html=1;image=data:image/png,;imageAlign=left;imageVerticalAlign=middle;imageWidth=24;imageHeight=24;spacingLeft=42;align=left;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=1.5;fontColor=#1E293B;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="316" width="560" height="96" as="geometry" />
        </mxCell>
        <mxCell id="mount" value="&lt;b&gt;pki_private_issuer&lt;/b&gt;&#xa;PKI mount in OpenBao's root namespace.&#xa;Role ogenki signs at pki_private_issuer/sign/ogenki" style="rounded=1;absoluteArcSize=1;arcSize=10;shadow=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=1.5;fontColor=#1E293B;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="460" width="560" height="80" as="geometry" />
        </mxCell>
        <mxCell id="leaf" value="&lt;b&gt;Leaf certificates&lt;/b&gt;&#xa;*.priv.aws.ogenki.io — 90 day duration, renewed 15 days out.&#xa;Certificate private-gateway-certificate → Secret private-gateway-tls" style="rounded=1;absoluteArcSize=1;arcSize=10;shadow=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;strokeWidth=1.5;fontColor=#1E293B;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="588" width="560" height="88" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="signs offline" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7C3AED;strokeWidth=1.5;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="root" target="inter">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e8" value="imported as the issuing CA" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7C3AED;strokeWidth=1.5;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="inter" target="mount">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e9" value="signs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7C3AED;strokeWidth=1.5;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="mount" target="leaf">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="caveat" value="&lt;b&gt;The root is offline.&lt;/b&gt; The intermediate was signed by it once with openssl, outside OpenTofu and outside OpenBao; only the intermediate certificate and key are imported into the mount. Rotating it means a manual signing ceremony — the trade this design accepts." style="text;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#64748B;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="70" y="690" width="560" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cm" value="&lt;b&gt;cert-manager&lt;/b&gt;&#xa;ns security — watches Certificate&#xa;resources and writes the Secret" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=10;shadow=1;whiteSpace=wrap;html=1;image=data:image/png,;imageAlign=left;imageVerticalAlign=middle;imageWidth=24;imageHeight=24;spacingLeft=42;align=left;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=1.5;fontColor=#1E293B;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="720" y="306" width="250" height="76" as="geometry" />
        </mxCell>
        <mxCell id="issuer" value="&lt;b&gt;ClusterIssuer openbao&lt;/b&gt;&#xa;vault.server: https://bao.priv.aws.ogenki.io:8200&#xa;vault.path: pki_private_issuer/sign/ogenki&#xa;auth: JWT at jwt/aws-0, projected SA token" style="rounded=1;absoluteArcSize=1;arcSize=10;shadow=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=1.5;fontColor=#1E293B;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1010" y="296" width="470" height="100" as="geometry" />
        </mxCell>
        <mxCell id="le" value="&lt;b&gt;ClusterIssuer letsencrypt-prod&lt;/b&gt;&#xa;ACME. Signs the public wildcard on platform-public.&#xa;letsencrypt-staging exists alongside it for dry runs." style="rounded=1;absoluteArcSize=1;arcSize=10;shadow=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;strokeWidth=1.5;fontColor=#1E293B;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1010" y="160" width="470" height="82" as="geometry" />
        </mxCell>
        <mxCell id="eso" value="&lt;b&gt;External Secrets Operator&lt;/b&gt;&#xa;ns security" style="rounded=1;absoluteArcSize=1;arcSize=10;shadow=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;strokeWidth=1.5;fontColor=#1E293B;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="720" y="480" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="css" value="&lt;b&gt;ClusterSecretStore clustersecretstore&lt;/b&gt;&#xa;provider: aws · service: SecretsManager&#xa;authenticated by EKS Pod Identity, not a key pair" style="rounded=1;absoluteArcSize=1;arcSize=10;shadow=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;strokeWidth=1.5;fontColor=#1E293B;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1010" y="470" width="470" height="82" as="geometry" />
        </mxCell>
        <mxCell id="sm" value="&lt;b&gt;Cloud secret manager&lt;/b&gt;&#10;AWS Secrets Manager · Google Secret Manager&#xa;29 ExternalSecrets across the repository pull from it.&#xa;Among them: the intermediate CA bundle and the CA&#xa;chain this diagram depends on, the OpenBao admin&#xa;password, the Flux GitHub App, Slack tokens,&#xa;Zitadel's master key, the Grafana admin login." style="rounded=1;absoluteArcSize=1;arcSize=10;shadow=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;strokeWidth=1.5;fontColor=#1E293B;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1010" y="596" width="470" height="130" as="geometry" />
        </mxCell>
        <mxCell id="k8ssec" value="&lt;b&gt;Kubernetes Secret&lt;/b&gt;&#xa;in the consuming namespace" style="rounded=1;absoluteArcSize=1;arcSize=10;shadow=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;strokeWidth=1.5;fontColor=#1E293B;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="720" y="620" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;endArrow=classic;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cm" target="issuer">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;endArrow=classic;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="eso" target="css">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;endArrow=classic;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="css" target="sm">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e21" value="materialises" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=1.5;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sm" target="k8ssec">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="994" y="686" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e22" value="signing request" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7C3AED;strokeWidth=1.5;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="issuer" target="mount">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
