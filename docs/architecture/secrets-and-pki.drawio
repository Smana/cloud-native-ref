            </Array>
            <mxPoint x="-130" y="0" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e23" value="one Secret only, the CA bundle:&#xa;cert-manager mints its own&#xa;projected SA token for auth" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#94A3B8;strokeWidth=1.5;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.15;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="k8ssec" target="issuer">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="845" y="420" />
              <mxPoint x="1080" y="420" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="ns" value="OpenBao namespace layout" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#7C3AED;verticalAlign=top;fontStyle=1;fontFamily=Helvetica;fontSize=13;fontColor=#1E293B;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="720" y="760" width="760" height="168" as="geometry" />
        </mxCell>
        <mxCell id="nsroot" value="&lt;b&gt;root namespace&lt;/b&gt;&#xa;Everything operational: pki_private_issuer, the&#xa;per-cluster JWT auth mounts, the admin userpass&#xa;login. sys/storage/raft/* is callable only from&#xa;here, which is why the snapshot job lives here." style="rounded=1;absoluteArcSize=1;arcSize=10;shadow=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=1.5;fontColor=#1E293B;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="740" y="796" width="350" height="116" as="geometry" />
        </mxCell>
        <mxCell id="nsapp" value="&lt;b&gt;app namespace&lt;/b&gt;&#xa;The only tenant namespace. Holds a secret/ kv-v2&#xa;mount reached through its own AppRole. Namespaces&#xa;are for tenants; shared platform services are not&#xa;tenants, so they stay in root." style="rounded=1;absoluteArcSize=1;arcSize=10;shadow=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=1.5;fontColor=#1E293B;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1110" y="796" width="350" height="116" as="geometry" />
        </mxCell>
        <mxCell id="snap" value="&lt;b&gt;CronJob openbao-snapshot&lt;/b&gt;&#xa;0 4 * * * — raft snapshot to S3 / Cloud Storage,&#xa;into the bucket the lineage stack owns&#xa;(opentofu/aws|gcp/openbao/lineage)" style="rounded=1;absoluteArcSize=1;arcSize=10;shadow=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;strokeWidth=1.5;fontColor=#1E293B;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="796" width="350" height="116" as="geometry" />
        </mxCell>
        <mxCell id="e28" value="sys/storage/raft/snapshot" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=1.5;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="snap" target="nsroot">
