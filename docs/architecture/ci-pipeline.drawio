          <mxGeometry x="476" y="892" width="26" height="14" as="geometry" />
        </mxCell>
        <mxCell id="__lgl3" value="path-filtered, not required" style="text;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#64748B;align=left;" vertex="1" parent="1">
          <mxGeometry x="510" y="890" width="180" height="16" as="geometry" />
