        <mxCell id="__lgl2" value="security scanning" style="text;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#64748B;align=left;" vertex="1" parent="1">
          <mxGeometry x="320" y="890" width="150" height="16" as="geometry" />
