        <mxCell id="__ts" value="This is what the platform is for. A developer writes the box on the left; the App composition renders everything to the right of it, security defaults included. Example: apps/base/complete/app.yaml." style="text;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#64748B;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="62" width="1300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="claim" value="&lt;b&gt;App — cloud.ogenki.io/v1alpha1&lt;/b&gt;&#xa;name: xplane-image-gallery · ns: apps&#xa;&#xa;  image.repository / tag&#xa;  replicas: 2 · resources&#xa;  service.port: 8080&#xa;  env / envFrom&#xa;&#xa;  route.enabled: true&#xa;  autoscaling.enabled: true&#xa;  pdb.enabled: true&#xa;  networkPolicies.enabled&#xa;  externalSecrets[]&#xa;  observability.metrics.enabled&#xa;  observability.alertingRules.groups[]&#xa;&#xa;  sqlInstance.enabled: true&#xa;  kvStore.enabled: true&#xa;  objectStore.enabled: true" style="rounded=1;absoluteArcSize=1;arcSize=10;shadow=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fillColor=#EEF2FF;strokeColor=#6366F1;strokeWidth=1.5;fontColor=#1E293B;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
