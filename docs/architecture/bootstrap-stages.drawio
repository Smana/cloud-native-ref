        <mxCell id="__t" value="Bootstrap — five OpenTofu stacks per cloud, in the order Terramate runs them" style="text;html=1;fontFamily=Helvetica;fontSize=22;fontStyle=1;fontColor=#1E293B;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="1100" height="30" as="geometry" />
        </mxCell>
        <mxCell id="__ts" value="Everything below has to exist before Flux can reconcile anything. Each stack declares what it runs after, and Terramate topologically sorts them. Both clouds build the SAME five stages, each from its own stack tree." style="text;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#64748B;align=left;" vertex="1" parent="1">
