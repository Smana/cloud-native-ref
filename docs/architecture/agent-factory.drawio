        <mxCell id="intake" value="&lt;b&gt;Intake · narration&lt;/b&gt;&#10;labelled issue → Task (fixed template)&#10;started / PR / end comments&#10;live gate pending" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;shadow=1;fillColor=#EEF2FF;strokeColor=#6366F1;fontColor=#1E293B;" vertex="1" parent="sp3"><mxGeometry x="20" y="40" width="250" height="80" as="geometry" /></mxCell>
