        <mxCell id="ui" value="&lt;b&gt;Web UI · oauth2-proxy&lt;/b&gt;&#10;ZITADEL SSO, agents-admin/-member&#10;watch · post or queue · hand to a role&#10;steer, interrupt: live gate pending" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;shadow=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#1E293B;" vertex="1" parent="sp2"><mxGeometry x="20" y="40" width="250" height="80" as="geometry" /></mxCell>
