<mxfile host="drawio" version="30.3.6">
  <diagram name="Agent Factory: target architecture" id="agent-factory">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1780" pageHeight="1390" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Agent Factory: target architecture" style="text;html=1;fontFamily=Helvetica;fontSize=22;fontColor=#1E293B;align=left;verticalAlign=top;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1200" height="30" as="geometry" /></mxCell>
        <mxCell id="subtitle" value="The whole programme once built: a labelled issue becomes sandboxed agent runs, each under its own identity, collaborating in a room. The agent is not trusted: every control sits outside the sandbox.&#10;The stroke of each box says how far it has got (legend, bottom left). The same manifests deploy to gcp-0 and aws-0." style="text;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#475569;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1700" height="40" as="geometry" /></mxCell>
        <mxCell id="trg" value="People and triggers" style="rounded=1;absoluteArcSize=1;arcSize=16;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;container=1;pointerEvents=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontStyle=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="1380" height="118" as="geometry" /></mxCell>
        <mxCell id="gh" value="&lt;b&gt;GitHub repository&lt;/b&gt;&#10;issue label factory/ready · factory/stop on a task&#10;PR review &quot;Request changes&quot; (built, not deployed)" style="shape=label;image=data:image/png,;imageAlign=left;imageVerticalAlign=middle;imageWidth=24;imageHeight=24;spacingLeft=42;align=left;rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;shadow=1;fillColor=#F1F5F9;strokeColor=#94A3B8;fontColor=#1E293B;" vertex="1" parent="trg"><mxGeometry x="20" y="36" width="400" height="70" as="geometry" /></mxCell>
        <mxCell id="runlore" value="&lt;b&gt;RunLore&lt;/b&gt;&#10;findings become&#10;factory tasks" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;dashed=1;dashPattern=2 3;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#64748B;" vertex="1" parent="trg"><mxGeometry x="440" y="36" width="180" height="70" as="geometry" /></mxCell>
        <mxCell id="cli" value="&lt;b&gt;CLI&lt;/b&gt;&#10;task agent:run&#10;(a hand-launched run)" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;shadow=1;fillColor=#F1F5F9;strokeColor=#94A3B8;fontColor=#1E293B;" vertex="1" parent="trg"><mxGeometry x="640" y="36" width="180" height="70" as="geometry" /></mxCell>
