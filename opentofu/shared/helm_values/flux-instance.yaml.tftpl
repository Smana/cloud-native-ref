# Flux Instance Helm values — shared by both clouds.
#
# Rendered with templatefile() from opentofu/aws/eks/configure/main.tf and
# opentofu/gcp/gke/configure/main.tf. Dynamic values (sync.url, sync.ref,
# sync.path) are passed via --set in each stack's Terramate script.
#
# This was two files. Stripped of comments they were 80 lines each and differed
# on exactly one: storage.class. The GCP copy carried an instruction to keep
# them in sync by hand -- "change one without the other and the two clusters'
# Flux behaviour drifts silently" -- which is the job a variable does reliably
# and a comment does not.
#
# ${storage_class} is the ONLY per-cloud value here. Each stack passes its own
# local.storage_class, the same local that populates the storage_class key in
# that cluster's Flux vars ConfigMap, so Flux's own artifact PVC and every
# workload PVC substituted by postBuild can no longer disagree.
#
# Anything genuinely per-cloud beyond this belongs in a --set, not a second copy
# of the file.

instance:
  distribution:
    version: "2.x"
    registry: "ghcr.io/fluxcd"
    artifact: "oci://ghcr.io/controlplaneio-fluxcd/flux-operator-manifests"
  components:
    - source-controller
    - kustomize-controller
    - helm-controller
    - notification-controller
    - source-watcher
    # Uncomment for image automation:
    # - image-reflector-controller
    # - image-automation-controller
  cluster:
    type: kubernetes
    networkPolicy: true
  sharding:
    key: "sharding.fluxcd.io/key"
    shards:
      - "apps"
  storage:
    class: "${storage_class}"
    size: "5Gi"
  sync:
    kind: GitRepository
    # Not a secret -- the NAME of the Secret holding the Git credentials.
    # checkov:skip=CKV_SECRET_6:see above
    pullSecret: "flux-system" # pragma: allowlist secret
  kustomize:
    patches:
      # Add GitHub provider to GitRepository
      - patch: |
          - op: add
            path: /spec/provider
            value: github
        target:
          kind: GitRepository
      # Tune source-controller resources
      - patch: |
          - op: add
            path: /spec/template/spec/containers/0/args/-
            value: --concurrent=10
          - op: replace
            path: /spec/template/spec/containers/0/resources/requests/cpu
            value: 100m
          - op: replace
            path: /spec/template/spec/containers/0/resources/requests/memory
            value: 128Mi
        target:
          kind: Deployment
          name: source-controller
      # Tune kustomize-controller resources
      - patch: |
          - op: add
            path: /spec/template/spec/containers/0/args/-
            value: --concurrent=6
          - op: add
            path: /spec/template/spec/containers/0/args/-
            value: --requeue-dependency=10s
          - op: add
            path: /spec/template/spec/containers/0/args/-
            value: --feature-gates=CancelHealthCheckOnNewRevision=true
          - op: replace
            path: /spec/template/spec/containers/0/resources/requests/cpu
            value: 200m
          - op: replace
            path: /spec/template/spec/containers/0/resources/requests/memory
            value: 256Mi
        target:
          kind: Deployment
          name: kustomize-controller
      # Enable CancelHealthCheckOnNewRevision for helm-controller
      # Cancels stale health checks when a new revision arrives, reducing MTTR
      - patch: |
          - op: add
            path: /spec/template/spec/containers/0/args/-
            value: --feature-gates=CancelHealthCheckOnNewRevision=true
        target:
          kind: Deployment
          name: helm-controller
      # Allow ingress from all namespaces for Gateway API L7 proxy
      # The default allow-egress policy only allows ingress from same namespace,
      # which blocks Cilium Gateway API L7 proxy traffic
      - patch: |
          - op: replace
            path: /spec/ingress/0/from
            value:
              - podSelector: {}
              - namespaceSelector: {}
        target:
          kind: NetworkPolicy
          name: allow-egress
