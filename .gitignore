## More on https://github.com/github/gitignore

# Local Claude state (lock files, scheduled task metadata)
.claude/scheduled_tasks.lock

# Superpowers git worktrees (superpowers:using-git-worktrees creates these)
.claude/worktrees/

# Superpowers subagent-driven-development scratch state (progress ledger,
# task briefs, review packages). Local coordination state, not repo content.
.superpowers/

# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

**.terraform.lock.hcl

# Crash log files
crash.log

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include override files you do wish to add to version control using negated pattern
#
# !example_override.tf

# Plan output of `tofu plan -out=...` (binary, transient).
*.tfplan
out.tfplan

# Ignore CLI configuration files
.terraformrc
terraform.rc

# TFSec cache
.tfsec

# VSCode
.vscode

# Secrets directory
**/.tls/*
.secrets

# Sensitive configuration files
*.tfvars
!*.tfvars.example
variables.auto.tfvars
*.auto.tfvars

# Certificate and key files
*.pem
*.key
*.crt
*.csr
*.p12
*.pfx

# The one certificate that MUST be committed: the offline PKI root's
# certificate, which .github/workflows/openbao-restore-drill.yml verifies the
# restored PKI chain against (`openssl verify -CAfile`). Without this negation
# the blanket `*.pem` above silently refuses `git add` and the drill fails every
# Monday with `No such file or directory` -- after having proved the restore
# worked.
#
# Safe because a root CERTIFICATE is public material: it is the trust anchor
# every client verifying a private-PKI certificate must already hold, it carries
# no private key, and committing it removes a cloud read from the one job whose
# whole value is being readable during an outage. The root's KEY never leaves the
# offline medium and is what `*.pem` above exists to keep out -- so this negation
# names one exact path rather than a glob, and `*.pem` keeps its full force
# everywhere else, `.github/` included.
!.github/openbao-root-ca.pem

# Backup files
*.backup
*.bak

# Environment files
.env
.env.local
.env.*.local
.envrc

# Virtual environment
.venv/
venv/
env/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*~

# IDE files
.idea/
*.swp
*.swo
*~

# Temporary files
*.tmp
*.temp

# Kubeconfig files (local development)
kubeconfig*
*.kubeconfig
!kubeconfig.example

# OpenBao specific
.vault-token
vault-token
*.vault

# AWS credentials
.aws/credentials
aws-credentials
credentials

# SSH keys
id_rsa*
id_ed25519*
*.priv

# Log files
*.log
logs/

# Coverage reports
coverage/
*.coverage

# Package manager files
node_modules/
.pnpm-debug.log*
.yarn-debug.log*
.yarn-error.log*

# Manifest validation artifacts (SPEC-007) — generated by scripts/validate-manifests.sh.
# Never committed: a committed catalog drifts from the XRDs, and a committed
# bundle becomes a second source of truth.
.schemas/
.bundle/

# Python bytecode — scripts/flux-schema/*.py are helper modules imported by
# the render scripts, so CPython drops __pycache__ next to them on every run.
__pycache__/
*.py[cod]
